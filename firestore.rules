rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check role in users collection
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isArtisan() {
      return isAuthenticated() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'artisan' || isAdmin());
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Artisans collection
    match /artisans/{artisanId} {
      allow read: if true; // Public profiles
      allow write: if isUser(artisanId) || isAdmin();
    }

    // Products collection
    match /products/{productId} {
      allow read: if true; // Everyone can browse products
      allow write: if isArtisan() || isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.artisanId || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.artisanId || isAdmin());
    }

    // Users collection
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if isUser(userId) || isAdmin();
    }

    // Analytics collections
    match /analytics/{eventId} {
      allow create: if true; // Allow anonymous tracking
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /visits/{visitId} {
      allow create: if true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /vlogs/{vlogId} {
      allow read: if true;
      allow create: if true; // Allow anyone to upload stories? Usually requires auth but user request says "Users and travel creators"
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
    }
  }
}
